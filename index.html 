<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Sam's Sublime</title>
<style>
*{box-sizing:border-box;margin:0}body{font-family:sans-serif;background:#fff0f6;display:flex;justify-content:center} .phone{width:100%;max-width:420px;background:#fff;min-height:100vh;padding:16px}.logo{font-weight:900;font-size:24px}.logo span{color:#ff6a00}.badge{background:#fff0e6;color:#ff6a00;padding:6px 12px;border-radius:20px;font-size:12px;font-weight:700;float:right}.hero{margin-top:20px}.hero h1{font-size:28px}.card{border:1px solid #eee;border-radius:18px;padding:16px;margin-top:16px}label{font-size:13px;color:#666;font-weight:700;display:block;margin:12px 0 6px}input{width:100%;padding:14px;border:1.5px solid #eee;border-radius:12px;font-size:16px} .pay-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:8px}.pay{border:1.5px solid #eee;border-radius:12px;padding:12px;text-align:center;font-weight:700}.pay.active{border-color:#ff6a00;background:#fff7ed;color:#ff6a00}.btn{width:100%;background:#ff6a00;color:#fff;border:none;padding:16px;border-radius:14px;font-weight:800;margin-top:14px}.result{background:#1a1a1a;color:#fff;border-radius:18px;padding:16px;margin-top:16px}.row{display:flex;justify-content:space-between;margin:8px 0}.big{font-size:20px;color:#ffbd8a;font-weight:900}
</style>
</head>
<body>
<div class="phone">
<div class="logo">Sam's <span>Sublime</span><span class="badge">Bujumbura</span></div>
<div class="hero">
<h1>Calculateur<br>Benefice Reel 💋</h1>
<p>Fini les pertes Lumicash 5% !</p>
<div class="card">
<label>Prix d'achat (FBU)</label><input id="achat" type="number" value="60000" oninput="calc()">
<label>Prix de vente (FBU)</label><input id="vente" type="number" value="120000" oninput="calc()">
<label>Livraison (FBU)</label><input id="livr" type="number" value="5000" oninput="calc()">
<label>Paiement</label><div class="pay-grid"><div class="pay active" id="pay-cash" onclick="setPay('cash')">Cash</div><div class="pay" id="pay-lumicash" onclick="setPay('lumicash')">Lumicash 5%</div></div>
<div class="result"><div class="row"><span>Chiffre</span><b id="ca"></b></div><div class="row"><span>Frais Lumicash</span><b id="frais"></b></div><div class="row"><span>Cout total</span><b id="cout"></b></div><hr style="margin:10px 0;border-color:#333"><div class="row"><span>Benefice NET</span><b class="big" id="benef"></b></div><div class="row"><span>Marge</span><b id="marge" style="color:#2ecc71"></b></div></div>
<button class="btn" onclick="calc()">Recalculer ✨</button>
</div>
</div>
</div>
<script>
let mode='cash';function setPay(m){mode=m;document.querySelectorAll('.pay').forEach(e=>e.classList.remove('active'));document.getElementById('pay-'+m).classList.add('active');calc()}
function fmt(n){return n.toLocaleString('fr-BI')+' FBU'}
function calc(){let a=+document.getElementById('achat').value||0;let v=+document.getElementById('vente').value||0;let l=+document.getElementById('livr').value||0;let f=mode==='lumicash'?v*0.05:0;let c=a+l+f;let b=v-c;let m=v>0?(b/v*100).toFixed(1)+'%':'0%';document.getElementById('ca').innerText=fmt(v);document.getElementById('frais').innerText=fmt(f);document.getElementById('cout').innerText=fmt(c);document.getElementById('benef').innerText=fmt(b);document.getElementById('marge').innerText=m}
calc();
</script>
</body>
</html>